{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile representation in FocusFlow",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "name", "email", "createdAt"]
    },
    "Task": {
      "title": "Task",
      "description": "User task item in FocusFlow",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "priority": { "type": "string", "enum": ["low", "medium", "high", "urgent"] },
        "status": { "type": "string", "enum": ["todo", "in_progress", "completed"] },
        "dueDate": { "type": "string" },
        "dueTime": { "type": "string" },
        "tags": { "type": "string" },
        "completed": { "type": "boolean" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "userId", "title", "priority", "status", "completed", "createdAt"]
    },
    "ShoppingItem": {
      "title": "ShoppingItem",
      "description": "Shopping list item",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "name": { "type": "string" },
        "quantity": { "type": "number" },
        "price": { "type": "number" },
        "category": { "type": "string" },
        "completed": { "type": "boolean" },
        "notes": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "userId", "name", "quantity", "completed", "createdAt"]
    },
    "Alert": {
      "title": "Alert",
      "description": "Scheduled reminder and alarm alert",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "date": { "type": "string" },
        "time": { "type": "string" },
        "userTimezone": { "type": "string" },
        "remindAtUtc": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "dismissed", "completed"] },
        "syncedToGoogle": { "type": "boolean" },
        "googleEventId": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "userId", "title", "date", "time", "status", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "User account document"
    },
    "/users/{userId}/tasks/{taskId}": {
      "schema": "Task",
      "description": "User tasks"
    },
    "/users/{userId}/shopping/{itemId}": {
      "schema": "ShoppingItem",
      "description": "User shopping items"
    },
    "/users/{userId}/alerts/{alertId}": {
      "schema": "Alert",
      "description": "User scheduled reminders and alerts"
    }
  }
}
